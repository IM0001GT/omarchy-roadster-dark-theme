# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#070708"

# Main text color
theme[main_fg]="#f4f1ec"

# Title color for boxes
theme[title]="#f4f1ec"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff3340"

# Background color of selected item in processes box
theme[selected_bg]="#2c1216"

# Foreground color of selected item in processes box
theme[selected_fg]="#d4b56e"

# Color of inactive/disabled text
theme[inactive_fg]="#8a8682"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e4e0da"

# Background color of the percentage meters
theme[meter_bg]="#2c1216"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e4e0da"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c47a90"
theme[mem_box]="#6eae80"
theme[net_box]="#ff3340"
theme[proc_box]="#d4b56e"

# Box divider line and small boxes line color
theme[div_line]="#8a8682"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#6eae80"
theme[temp_mid]="#d4b56e"
theme[temp_end]="#ff3340"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#7eb8b8"
theme[cpu_mid]="#6d86a8"
theme[cpu_end]="#c47a90"

# Mem/Disk free meter
theme[free_start]="#c47a90"
theme[free_mid]="#6d86a8"
theme[free_end]="#7eb8b8"

# Mem/Disk cached meter
theme[cached_start]="#6d86a8"
theme[cached_mid]="#7eb8b8"
theme[cached_end]="#c47a90"

# Mem/Disk available meter
theme[available_start]="#d4b56e"
theme[available_mid]="#ff3340"
theme[available_end]="#ff3340"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#6eae80"
theme[used_mid]="#7eb8b8"
theme[used_end]="#6d86a8"

# Download graph colors
theme[download_start]="#d4b56e"
theme[download_mid]="#ff3340"
theme[download_end]="#ff3340"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#6eae80"
theme[upload_mid]="#7eb8b8"
theme[upload_end]="#6d86a8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7eb8b8"
theme[process_mid]="#6d86a8"
theme[process_end]="#c47a90"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#070708"
theme[gradient_color_1]="#141416"
theme[gradient_color_2]="#2c1216"
theme[gradient_color_3]="#8a8682"
theme[gradient_color_4]="#9a9692"
theme[gradient_color_5]="#f4f1ec"
theme[gradient_color_6]="#e4e0da"
theme[gradient_color_7]="#fbfbfb"
